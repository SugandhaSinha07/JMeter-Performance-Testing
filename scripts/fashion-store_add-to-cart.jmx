                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{"variables":{"handles":["womens-bags","mens-bags","womens-apparel","mens-apparel","home-bedding"]},"query":"query ($handles: [String]) {\n  allCollections: collections(handles: $handles) {\n    edges {\n      node {\n        id\n        title\n        handle\n        image {\n          originalSrc\n          __typename\n        }\n        metafields {\n          edges {\n            node {\n              id\n              key\n              value\n              __typename\n            }\n            __typename\n          }\n          __typename\n        }\n        products {\n          edges {\n            node {\n              ...ProductCard\n              __typename\n            }\n            __typename\n          }\n          __typename\n        }\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n  departments {\n    edges {\n      node {\n        id\n        title\n        handle\n        categories {\n          edges {\n            node {\n              id\n              title\n              image {\n                originalSrc\n                __typename\n              }\n              metafields {\n                edges {\n                  node {\n                    id\n                    key\n                    value\n                    __typename\n                  }\n                  __typename\n                }\n                __typename\n              }\n              handle\n              products {\n                edges {\n                  node {\n                    ...ProductCard\n                    __typename\n                  }\n                  __typename\n                }\n                __typename\n              }\n              __typename\n            }\n            __typename\n          }\n          __typename\n        }\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n}\n\nfragment ProductCard on Product {\n  id\n  title\n  handle\n  description\n  priceRange {\n    minVariantPrice {\n      amount\n      __typename\n    }\n    maxVariantPrice {\n      amount\n      __typename\n    }\n    __typename\n  }\n  metafields {\n    edges {\n      node {\n        id\n        key\n        value\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n  variants {\n    edges {\n      node {\n        id\n        availableForSale\n        price\n        image {\n          originalSrc\n          __typename\n        }\n        sku\n        selectedOptions {\n          value\n          name\n          __typename\n        }\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n  __typename\n}\n"}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
